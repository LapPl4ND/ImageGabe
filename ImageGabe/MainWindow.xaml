<Window x:Class="ImageGabe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageGabe" Width="480" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">

    <Grid Margin="18">
        <!-- Fond + ombre portée de la fenêtre -->
        <Border CornerRadius="18" Background="{DynamicResource BgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Fond "ambiant" : la pochette floutée derrière toute l'interface -->
            <Image x:Name="ambientImage" Grid.RowSpan="2" Stretch="UniformToFill" Margin="-140" Opacity="0"
                   IsHitTestVisible="False">
                <Image.Effect>
                    <BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
            <Border Grid.RowSpan="2" IsHitTestVisible="False" Background="{DynamicResource AmbientOverlayBrush}"/>

            <!-- ===== Barre de titre ===== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Grid Width="24" Height="24">
                        <!-- Logo de secours si app.ico n'est pas trouvé -->
                        <Border x:Name="titleFallback" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Icône de l'app (app.ico) -->
                        <Image x:Name="titleIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="ImageGabe" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE713;" FontSize="13"
                            ToolTip="{DynamicResource S.Settings}" Click="OpenSettings_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Margin="4,0,0,0"
                            ToolTip="{DynamicResource S.Minimize}" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Margin="4,0,0,0"
                            ToolTip="{DynamicResource S.Close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== Contenu ===== -->
            <Grid Grid.Row="1" Margin="24,4,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource S.Heading}" Foreground="{DynamicResource TextBrush}"
                               FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource S.Subheading}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Champ de lien + bouton Aperçu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Border Height="54" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge de plateforme (couleur + icône selon le lien) -->
                            <Border x:Name="platformBadge" Width="28" Height="28" CornerRadius="8" Margin="13,0,10,0"
                                    Background="{DynamicResource SubtleBrush}">
                                <Grid>
                                    <TextBlock x:Name="platformGlyph" Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Logo officiel de la plateforme (Assets/Logos/*.png) -->
                                    <Image x:Name="platformLogo" Stretch="Uniform" Visibility="Collapsed"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <TextBox x:Name="txtUrl" Grid.Column="1" Style="{StaticResource BareTextBox}"
                                     Tag="{DynamicResource S.Placeholder}"
                                     TextChanged="TxtUrl_TextChanged" KeyDown="TxtUrl_KeyDown"/>

                            <Button Grid.Column="2" Style="{StaticResource ChipButton}" Margin="8,0,10,0"
                                    Click="Paste_Click" ToolTip="{DynamicResource S.PasteTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource S.Paste}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Button x:Name="btnPreview" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="BtnPreview_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.Preview}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Zone d'aperçu -->
                <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <!-- État vide -->
                        <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource SubtleBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource S.EmptyTitle}" Foreground="{DynamicResource TextBrush}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="{DynamicResource S.EmptyHint}" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Image -->
                        <Image x:Name="picPreview" Stretch="Uniform" Margin="14" Opacity="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"
                               SizeChanged="PicPreview_SizeChanged">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="previewScale" ScaleX="1" ScaleY="1"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Chargement -->
                        <Grid x:Name="loadingOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource SubtleBrush}" StrokeThickness="4"/>
                                    <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M20,2 A18,18 0 0 1 38,20">
                                        <Path.RenderTransform>
                                            <RotateTransform CenterX="20" CenterY="20"/>
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Loading}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Infos : titre, auteur · plateforme, résolution -->
                <Grid x:Name="metaPanel" Grid.Row="3" Margin="2,14,2,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtTitle" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtAuthor" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SubtleBrush}" Padding="9,4" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="qualityDot" Width="6" Height="6" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtResolution" Foreground="{DynamicResource TextBrush}" FontSize="11.5"
                                       FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Actions -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDownload" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Click="BtnDownload_Click" ToolTip="Ctrl + S">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.Save}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCopy" Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="46" Padding="0"
                            Margin="10,0,0,0" IsEnabled="False" Click="BtnCopy_Click" ToolTip="{DynamicResource S.CopyTip}">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Panneau Paramètres ===== -->
            <Grid x:Name="settingsOverlay" Grid.Row="1" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
                  Opacity="0" MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
                <Border VerticalAlignment="Center" Margin="22,0,22,22" CornerRadius="18" Padding="22"
                        Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource S.SettingsTitle}" Foreground="{DynamicResource TextBrush}"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                                    ToolTip="{DynamicResource S.Close}" Click="CloseSettings_Click"/>
                        </Grid>

                        <!-- Thème -->
                        <TextBlock Text="{DynamicResource S.Theme}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,18,0,8"/>
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="4">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="rbDark" GroupName="Theme" Style="{StaticResource SegmentButton}" Checked="Setting_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.ThemeDark}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbLight" GroupName="Theme" Style="{StaticResource SegmentButton}" Checked="Setting_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.ThemeLight}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <!-- Langue -->
                        <TextBlock Text="{DynamicResource S.Language}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="4">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="rbFr" GroupName="Lang" Style="{StaticResource SegmentButton}"
                                             Content="Français" Checked="Setting_Changed"/>
                                <RadioButton x:Name="rbEn" GroupName="Lang" Style="{StaticResource SegmentButton}"
                                             Content="English" Checked="Setting_Changed"/>
                            </UniformGrid>
                        </Border>

                        <!-- Format par défaut -->
                        <TextBlock Text="{DynamicResource S.Format}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="4">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="rbJpg" GroupName="Format" Style="{StaticResource SegmentButton}"
                                             Content="JPG" Checked="Setting_Changed"/>
                                <RadioButton x:Name="rbPng" GroupName="Format" Style="{StaticResource SegmentButton}"
                                             Content="PNG" Checked="Setting_Changed"/>
                            </UniformGrid>
                        </Border>

                        <!-- Mises à jour -->
                        <TextBlock Text="{DynamicResource S.Updates}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="chkAutoUpdate" Style="{StaticResource SwitchStyle}" Content="{DynamicResource S.AutoCheck}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <Grid Margin="0,14,0,0">
                            <TextBlock x:Name="txtVersion" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="btnCheckUpdates" Style="{StaticResource SecondaryButton}" Height="36"
                                    HorizontalAlignment="Right" Click="CheckUpdates_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource S.CheckNow}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Liseré de la fenêtre -->
            <Border Grid.RowSpan="2" CornerRadius="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    IsHitTestVisible="False"/>

            <!-- ===== Toast (notifications) ===== -->
            <Border x:Name="toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,86"
                    CornerRadius="12" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1" Padding="14,10" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="toastShift" Y="12"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="toastIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="toastText" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                    <Button x:Name="toastAction" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="ToastAction_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>